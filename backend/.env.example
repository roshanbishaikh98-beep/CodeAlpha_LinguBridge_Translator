# Port the Express API server listens on
PORT=5000

# Origin allowed to call this API (your frontend dev server)
CORS_ORIGIN=http://localhost:5173

# Translation provider base URL.
# Default uses the free MyMemory Translation API (https://mymemory.translated.net),
# which needs NO API key for normal use.
TRANSLATION_API_URL=https://api.mymemory.translated.net/get

# OPTIONAL: registering a free email with MyMemory raises your daily quota
# from 5,000 to 50,000 words/day. Leave blank to use the anonymous quota.
# See: https://mymemory.translated.net/doc/keygen.php
TRANSLATION_API_EMAIL=

# OPTIONAL: if you switch TRANSLATION_API_URL to a key-based provider
# (e.g. Google Cloud Translation, DeepL, Azure Translator, RapidAPI), put
# the key here. It is only ever read on the server and is never sent to
# the browser. The backend already reads this value — see routes/translate.js.
TRANSLATION_API_KEY=
